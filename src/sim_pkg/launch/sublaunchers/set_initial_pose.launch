<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <arg name="initial_x" default="11.775"/>
  <arg name="initial_y" default="2.04"/>
  <arg name="initial_z" default="0.032939"/>
  <arg name="initial_yaw" default="0.0"/>
  <arg name="initial_roll" default="0.0"/>
  <arg name="initial_pitch" default="0.0"/>
  <arg name="frame_id" default="map"/>
  <arg name="child_frame_id" default="base_link"/>

  <node pkg="sim_pkg" exec="set_initial_pose.py" name="set_initial_pose" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="initial_x" value="$(var initial_x)"/>
    <param name="initial_y" value="$(var initial_y)"/>
    <param name="initial_z" value="$(var initial_z)"/>
    <param name="initial_yaw" value="$(var initial_yaw)"/>
    <param name="initial_roll" value="$(var initial_roll)"/>
    <param name="initial_pitch" value="$(var initial_pitch)"/>
    <param name="frame_id" value="$(var frame_id)"/>
    <param name="child_frame_id" value="$(var child_frame_id)"/>
  </node>
</launch>
