<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <include file="$(find-pkg-share sim_pkg)/launch/gazebo.launch">
    <arg name="gui" value="false"/>
  </include>
  <include file="$(find-pkg-share sim_pkg)/launch/sublaunchers/car.launch"/>
  <include file="$(find-pkg-share sim_pkg)/launch/sublaunchers/wheel_imu_odom.launch"/>
  <include file="$(find-pkg-share sim_pkg)/launch/sublaunchers/robot_localization.launch"/>
  <include file="$(find-pkg-share sim_pkg)/launch/sublaunchers/set_initial_pose.launch"/>
</launch>
